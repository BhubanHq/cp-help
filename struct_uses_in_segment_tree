#include<bits/stdc++.h> 
#define endl "\n"
#define ll long long
#define ld long double
#define Faster  ios_base::sync_with_stdio(false);cin.tie(0);cout.tie(0) 
using namespace std;
ll mod = 1e9+7;
const ll N = 1e5 + 7;
const ll m = 2e5 + 4;
ll inf = 1e15;


ll arr[N];

struct node{
  ll mn, count;
};

node t[N * 4];

node merge(node l, node r){
  node ans;
  ans.mn = min(l.mn , r.mn);
  ans.count = 0;

  if(l.mn == ans.mn) ans.count += l.count;
  if(r.mn == ans.mn) ans.count += r.count;

  return ans;
}

void build(ll n, ll b, ll e){
   if(b==e){
      t[n].mn = arr[b];
      t[n].count = 1;
      return;
   }

   ll l = 2*n, r = 2*n +1;
   ll mid = (b+e)/2;

   build(l, b, mid);
   build(r, mid+1, e);
   t[n] = merge(t[l] , t[r]);       // change this

}


node query(ll n, ll b, ll e, ll i, ll j){
   if(b > j or e < i) return {inf, 1};       // return appropriate value
   if(b >= i && e<= j){
      return t[n];
   }

   ll l= 2*n, r = 2*n + 1;
   ll mid = (e+b)/2;
   return merge(query(l, b, mid, i, j),query(r, mid + 1, e, i, j));  // change this
}

void upd(ll n, ll b, ll e, ll i, ll x){
   if(e < i or i < b) return;
   if(b==e && b==i){
      t[n].mn = x;
      t[n].count = 1;            // update
      return;
   }

   ll l = n*2, r = n*2 + 1;
   ll mid = (b+e)/2;
   upd(l, b, mid, i, x);
   upd(r, mid+1, e, i, x);

   t[n] = merge(t[l], t[r]);         // change this
}

 
 void solve(){
  ll n, q;
  cin >> n >> q;

  for(ll i = 1 ; i <= n ; i++){
    cin >> arr[i];
  }

  build(1 , 1, n);
  while(q--){
    ll x, y, z;
    cin >> x >> y >> z;

    if(x == 1) upd(1, 1, n, y+1, z);
    else{
      node ans = query(1 , 1 , n, y+1, z);
      cout<<ans.mn<<' '<<ans.count<<endl;
    }
  }
   
}

 
int main()
{
    Faster;
    int t=1;
   // cin >> t; 
    while(t--)
    {  
       solve();
      
     }
    return 0;
 
}